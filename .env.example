# Copy this file to .env for local runs. NEVER commit the real .env.
# In GitHub Actions, set these as repository SECRETS instead (see SETUP.md).

# Your router (NaraRouter) — the only one you need to start
NARAROUTER_API_KEY=
NARAROUTER_BASE_URL=https://router.bynara.id/v1
NARAROUTER_MODEL=nemotron-3-ultra

# Optional fallbacks
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Provided automatically inside GitHub Actions
# GITHUB_TOKEN=
